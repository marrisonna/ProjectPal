# Copy this file to .env and fill in real values before running docker compose.
# .env is git-ignored (see .gitignore) — never commit real credentials.

POSTGRES_DB=projectpal
POSTGRES_USER=projectpal
POSTGRES_PASSWORD=change-me-to-a-strong-local-password

# Signs/verifies JWTs issued by the REST API (Claude/Level1_Implementation/2_RestApi/Plan.md).
# Generate a real one locally, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-random-secret

# Optional — how long a login stays valid, in seconds. Defaults to 8 hours
# (28800) if left unset (Claude/Level1_Implementation/3_Authentication/Plan.md D1.3-6).
JWT_TTL_SECONDS=28800
