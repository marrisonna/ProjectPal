# Copy this file to .env.local before running `npm run dev`.
# Vite only exposes variables prefixed VITE_ to client code, and reads
# .env.local automatically (already git-ignored by the Vite template).

# The REST API's base URL. Relative today because vite.config.ts's dev-server
# proxy stands in for Caddy's future /api/* routing (D1.6-4) — the same value
# keeps working unchanged once Caddy actually exists
# (Claude/Level1_Implementation/6_HttpsReverseProxy/Plan.md).
VITE_API_BASE_URL=/api
